{
  "name": "@jens-johnson/style-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jens Johnson's opinionated style guide: conventions docs, shareable tooling configs, and developer utilities",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./prettier": "./src/configs/prettier/index.json",
    "./eslint": "./src/configs/eslint/index.mjs",
    "./stylelint": "./src/configs/stylelint/index.mjs",
    "./commitlint": "./src/configs/commitlint/index.mjs",
    "./tsconfig": "./src/configs/tsconfig/base.json",
    "./utils/developer-tooling/file-header-generator": "./src/utils/developer-tooling/file-header-generator/index.ts"
  },
  "bin": {
    "file-header-generator": "./bin/file-header-generator.ts"
  },
  "prettier": "./src/configs/prettier/index.json",
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "header": "tsx bin/file-header-generator.ts",
    "header:banner": "tsx bin/file-header-generator.ts banner",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.20.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import-x": "^4.10.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "figlet": "^1.8.0",
    "globals": "^16.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.29.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "lefthook": "^1.11.0",
    "prettier": "^3.5.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3",
    "stylelint": ">=16",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  }
}
